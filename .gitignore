# ML - model archive: ignore semua kecuali model liveness yang dipakai
ml/**/model_archive/*.h5
ml/**/model_archive/*.pt
ml/**/model_archive/*.onnx
!ml/face_recognition/model_archive/MiniFASNetV2.onnx

# ML - base pretrained weight (bukan model final)
/yolo26n.pt
/yolo26s.pt

