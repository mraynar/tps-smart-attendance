node_modules/
.next/
out/

# ML - dataset training (jangan commit, terlalu besar)
ml/plate_detection/dataset/

# ML - training runs: ignore semua kecuali model terbaik (plate_detector_v2/weights/best.pt)
ml/**/runs/*
!ml/plate_detection/runs/plate_detector_v2
